# H-Connect backend environment
# Copy to backend/.env and fill in. Never commit .env.

PORT=5000

# Supabase (Project Settings -> API)
SUPABASE_URL=
# New Supabase API keys (publishable is public; secret is server-only).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy equivalents are also accepted:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Sarvam speech recognition, translation, and voice generation (server-only).
SARVAM_API_KEY=

# LLM (any OpenAI-compatible chat completions endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Comma separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173